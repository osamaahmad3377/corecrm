# ============================================================================
#  CoreCRM — IT Support & Client Portal — environment variables
#  Copy to `.env` for local development. NEVER commit real secrets.
# ============================================================================

# --- Database (PostgreSQL) --------------------------------------------------
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://corecrm:corecrm@localhost:5433/corecrm?schema=public"
# Direct (non-pooled) connection string used for `prisma migrate`.
# On Neon/Supabase this is the non-pooling URL. Locally it is the same as above.
DIRECT_URL="postgresql://corecrm:corecrm@localhost:5433/corecrm?schema=public"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL of the app. Locally http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# --- Encryption -----------------------------------------------------------
# 32-byte key, base64-encoded. Used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-32-byte-base64-key===================="

# --- File storage (Vercel Blob) -----------------------------------------
# Leave blank locally to use the on-disk dev fallback (.uploads/).
# In production set the token from your Vercel Blob store.
BLOB_READ_WRITE_TOKEN=""

# --- Microsoft 365 / Graph (Phase 3 — email) --------------------------
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
# Redirect URI to register: {APP_URL}/api/emails/accounts/callback/microsoft

# --- Google Workspace / Gmail (Phase 3 — email) ----------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Redirect URI to register: {APP_URL}/api/emails/accounts/callback/google
GOOGLE_PUBSUB_TOPIC=""
GOOGLE_PUBSUB_VERIFICATION_AUDIENCE=""

# --- Webhooks / Cron -----------------------------------------------------
# Shared secret echoed back by MS Graph subscriptions (clientState) and used
# to authenticate provider webhook calls.
EMAIL_WEBHOOK_SECRET="replace-me-webhook-secret"
# Bearer secret required by Vercel Cron endpoints (/api/cron/*).
CRON_SECRET="replace-me-cron-secret"

# --- Rate limiting (Upstash Redis) ------------------------------------
# Optional. If unset, an in-memory limiter is used (fine for a single instance
# / local dev, not for multi-region production).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Transactional email (outbound notifications) --------------------
# Provider used to send invitations / notifications. If unset, emails are
# written to the server log (dev mode).
EMAIL_FROM="CoreCRM Support <support@example.com>"
RESEND_API_KEY=""
